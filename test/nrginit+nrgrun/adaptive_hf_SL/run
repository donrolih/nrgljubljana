#!/bin/bash
set -euo pipefail
# $1 = PROJECT_SOURCE_DIR, $2 = PROJECT_BINARY_DIR, $3 = this directory, $4 = Mathematica kernel
#
# adaptive_hf (test/adaptive) through nrginit: three runs at z = 0.5 and 0.5 +- 1e-4, each with its chain from nrgchain
# in xi.dat, zeta.dat, theta.dat and a neighbouring chain in dz/ (dz/dz.dat holds dz = z' - z); nrginit writes the
# D block, nrg dumps dE/dz, and compare_hf.pl compares the middle run with the central differences.
source_dir=$1
build_dir=$2
test_dir=$3
kernel=$4
nrginit="$source_dir/nrginit/nrginit"
[[ -e "${nrginit}.local" ]] && nrginit="${nrginit}.local"
export PATH="$build_dir/tools:$build_dir/c++:$PATH"

z=0.5
dz=1e-4
zm=$(perl -e "print $z - $dz")
zp=$(perl -e "print $z + $dz")

chain() { # chain DIR Z
  mkdir -p "$1"
  sed "s/@Z@/$2/" "$test_dir/param-nrgchain" > "$1/param-nrgchain"
  (cd "$1" && nrgchain param-nrgchain > nrgchain.log)
}
rm -rf chain_m chain_0 chain_p zm z0 zp
chain chain_m "$zm"
chain chain_0 "$z"
chain chain_p "$zp"

run() { # run DIR Z CHAIN DCHAIN DZ
  local dir=$1 zz=$2 ch=$3 dch=$4 shift=$5
  mkdir -p "$dir/dz"
  sed "s/@Z@/$zz/" "$test_dir/param" > "$dir/param"
  cp "$ch/xi.dat" "$ch/zeta.dat" "$dir/"
  cp chain_0/theta.dat "$dir/" # one hybridization for all runs: the initial cluster must not depend on z
  cp "$dch/xi.dat" "$dch/zeta.dat" "$dir/dz/"
  echo "$shift" > "$dir/dz/dz.dat"
  (
    cd "$dir"
    "$nrginit" "$kernel" > nrginit.log 2>&1 || { echo "$dir: nrginit failed"; tail -20 nrginit.log; exit 1; }
    grep -q '^D ' data || { echo "$dir: no D block in data"; exit 1; }
    nrg > log 2>&1 || { echo "$dir: nrg failed"; tail -20 log; exit 1; }
    [ -f DONE ] || { echo "$dir: no DONE"; exit 1; }
  )
}
run zm "$zm" chain_m chain_0 "$dz"
run z0 "$z"  chain_0 chain_p "$dz"
run zp "$zp" chain_p chain_0 "-$dz"

echo "=== comparison"
perl "$source_dir/test/adaptive/compare_hf.pl" --lambda=2.0 --dz="$dz" --tol=1e-3 --gap=1e-3 zm/dEdz.nrg z0/dEdz.nrg zp/dEdz.nrg
